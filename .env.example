# ==========================================
# AdPulse — Configuration & Environment File
# ==========================================

# Application Name
APP_NAME=AdPulse
ENVIRONMENT=production
DEBUG=false

# Database (PostgreSQL)
POSTGRES_USER=adpulse
POSTGRES_PASSWORD=adpulse_secure_password_replace_me
POSTGRES_DB=adpulse
DATABASE_URL=postgresql+asyncpg://adpulse:adpulse_secure_password_replace_me@db:5432/adpulse

# Security & Encryption
# Generate JWT secret: openssl rand -hex 32
SECRET_KEY=change_this_to_a_secure_random_jwt_secret_key_min_32_chars!

# Fernet encryption key for encrypting Meta tokens at rest (32 url-safe base64-encoded bytes)
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=RXTngY_mhqpVeoaAoKtb7q11yY_4CLFo7IwLIp0HqXI=

# Registration toggle (set to false to close sign-ups)
ALLOW_REGISTRATION=true

# Meta Marketing API Settings (pinned version)
META_GRAPH_API_VERSION=v21.0
META_GRAPH_API_BASE=https://graph.facebook.com/v21.0

# Attribution & Final Data Delay
# Meta revises recent numbers. Reports will not be sent until at least N hours after the period ends.
FINAL_DATA_DELAY_HOURS=6

# Telegram Bot Delivery (aiogram 3)
# 1. Create a bot with @BotFather in Telegram
# 2. Paste token and username below:
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_BOT_USERNAME=AdPulseReportsBot
# Optional webhook URL (if empty, long-polling is used automatically)
TELEGRAM_WEBHOOK_URL=

# Google Sheets Delivery
# 1. Create a Service Account in Google Cloud Console with Google Sheets API enabled
# 2. Paste the service account email and JSON credentials (string or file path)
GOOGLE_SERVICE_ACCOUNT_EMAIL=adpulse-service@adpulse-reports.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "adpulse-reports", "private_key_id": "...", "private_key": "...", "client_email": "adpulse-service@adpulse-reports.iam.gserviceaccount.com"}
